# ---- Server ----
NODE_ENV=development
PORT=3000
API_PREFIX=api
# Flutter web dev server. `flutter run -d chrome` picks a random port unless
# you pass --web-port, so the run script below pins it to 5000.
CORS_ORIGINS=http://localhost:5000,http://127.0.0.1:5000,http://localhost:3000

# ---- PostgreSQL ----
# The migrate script and Prisma both read DATABASE_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/btech_predictor?schema=public
DB_POOL_MAX=20

# ---- Redis ----
# Leave empty to use an in-memory cache (fine for local dev, not for production).
REDIS_URL=
CACHE_TTL_SECONDS=300

# ---- Auth ----
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# ---- Ingestion ----
# Master switch. Keep false in development so nobody hammers official portals.
INGESTION_ENABLED=false
INGESTION_USER_AGENT=BTechAdmissionPredictor/0.1 (+contact@example.com)
# Minimum delay between two requests to the SAME host, milliseconds.
INGESTION_MIN_REQUEST_INTERVAL_MS=2000
INGESTION_ARTIFACT_DIR=./storage/artifacts
