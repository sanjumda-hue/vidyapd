generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions", "views"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [btree_gin, citext, pg_trgm, pgcrypto]
}

/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model branch_aliases {
  id                       Int                      @id @default(autoincrement())
  branch_id                Int                      @db.SmallInt
  specialization_id        Int?
  alias                    String
  normalized_alias         String
  counselling_authority_id Int?                     @db.SmallInt
  created_at               DateTime                 @default(now()) @db.Timestamptz(6)
  branches                 branches                 @relation(fields: [branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  counselling_authorities  counselling_authorities? @relation(fields: [counselling_authority_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  specializations          specializations?         @relation(fields: [specialization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([normalized_alias(ops: raw("gin_trgm_ops"))], map: "idx_branch_aliases_trgm", type: Gin)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model branches {
  id                 Int                  @id @default(autoincrement()) @db.SmallInt
  code               String               @unique
  name               String
  stream             String               @default("core")
  description        String?
  icon               String?
  is_popular         Boolean              @default(false)
  display_order      Int                  @default(100) @db.SmallInt
  is_active          Boolean              @default(true)
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  branch_aliases     branch_aliases[]
  college_branches   college_branches[]
  prediction_results prediction_results[]
  specializations    specializations[]

  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_branches_name_trgm", type: Gin)
}

model categories {
  id                      Int                       @id @default(autoincrement()) @db.SmallInt
  code                    String                    @unique
  name                    String
  is_open_pool            Boolean                   @default(false)
  display_order           Int                       @default(100) @db.SmallInt
  created_at              DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                  @default(now()) @db.Timestamptz(6)
  college_fees            college_fees[]
  cutoff_data             cutoff_data[]
  exam_rank_data          exam_rank_data[]
  percentile_rank_mapping percentile_rank_mapping[]
  prediction_requests     prediction_requests[]
  seat_types              seat_types[]
  user_profiles           user_profiles[]
}

model cities {
  id               Int                @id @default(autoincrement())
  state_id         Int                @db.SmallInt
  name             String
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  states           states             @relation(fields: [state_id], references: [id], onUpdate: NoAction)
  college_campuses college_campuses[]
  colleges         colleges[]

  @@unique([state_id, name])
  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_cities_name_trgm", type: Gin)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model college_accreditations {
  id            BigInt             @id @default(autoincrement())
  college_id    Int
  kind          accreditation_kind
  category      String?
  academic_year Int                @db.SmallInt
  rank_value    Int?               @db.SmallInt
  grade         String?
  score         Decimal?           @db.Decimal(6, 2)
  valid_from    DateTime?          @db.Date
  valid_to      DateTime?          @db.Date
  source_id     Int?
  created_at    DateTime           @default(now()) @db.Timestamptz(6)
  updated_at    DateTime           @default(now()) @db.Timestamptz(6)
  colleges      colleges           @relation(fields: [college_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  data_sources  data_sources?      @relation(fields: [source_id], references: [id], onUpdate: NoAction, map: "fk_college_accreditations_source")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model college_branches {
  id                 BigInt               @id @default(autoincrement())
  college_id         Int
  branch_id          Int                  @db.SmallInt
  specialization_id  Int?
  campus_id          Int?
  program_name       String
  degree             degree_type          @default(BTech)
  duration_years     Decimal              @default(4.0) @db.Decimal(3, 1)
  total_intake       Int?                 @db.SmallInt
  is_active          Boolean              @default(true)
  started_year       Int?                 @db.SmallInt
  discontinued_year  Int?                 @db.SmallInt
  created_at         DateTime             @default(now()) @db.Timestamptz(6)
  updated_at         DateTime             @default(now()) @db.Timestamptz(6)
  branches           branches             @relation(fields: [branch_id], references: [id], onUpdate: NoAction)
  college_campuses   college_campuses?    @relation(fields: [campus_id], references: [id], onUpdate: NoAction)
  colleges           colleges             @relation(fields: [college_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  specializations    specializations?     @relation(fields: [specialization_id], references: [id], onUpdate: NoAction)
  college_fees       college_fees[]
  cutoff_data        cutoff_data[]
  placement_data     placement_data[]
  prediction_results prediction_results[]
  seat_matrix        seat_matrix[]
  user_shortlists    user_shortlists[]

  @@unique([id, college_id, branch_id], map: "uq_college_branch_identity")
}

model college_campuses {
  id               Int                @id @default(autoincrement())
  college_id       Int
  name             String
  state_id         Int                @db.SmallInt
  city_id          Int?
  address          String?
  is_main          Boolean            @default(false)
  created_at       DateTime           @default(now()) @db.Timestamptz(6)
  updated_at       DateTime           @default(now()) @db.Timestamptz(6)
  college_branches college_branches[]
  cities           cities?            @relation(fields: [city_id], references: [id], onUpdate: NoAction)
  colleges         colleges           @relation(fields: [college_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  states           states             @relation(fields: [state_id], references: [id], onUpdate: NoAction)
  hostel_data      hostel_data[]

  @@unique([college_id, name])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model contains an expression index which requires additional setup for migrations. Visit https://pris.ly/d/expression-indexes for more info.
model college_fees {
  id                 BigInt            @id @default(autoincrement())
  college_id         Int
  college_branch_id  BigInt?
  academic_year      Int               @db.SmallInt
  quota_id           Int?              @db.SmallInt
  category_id        Int?              @db.SmallInt
  tuition_fee_annual Decimal?          @db.Decimal(12, 2)
  hostel_fee_annual  Decimal?          @db.Decimal(12, 2)
  mess_fee_annual    Decimal?          @db.Decimal(12, 2)
  other_fee_annual   Decimal?          @db.Decimal(12, 2)
  one_time_fee       Decimal?          @db.Decimal(12, 2)
  caution_deposit    Decimal?          @db.Decimal(12, 2)
  total_course_fee   Decimal?          @db.Decimal(12, 2)
  currency           String            @default("INR") @db.Char(3)
  source_id          Int?
  created_at         DateTime          @default(now()) @db.Timestamptz(6)
  updated_at         DateTime          @default(now()) @db.Timestamptz(6)
  categories         categories?       @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  college_branches   college_branches? @relation(fields: [college_branch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  colleges           colleges          @relation(fields: [college_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  quotas             quotas?           @relation(fields: [quota_id], references: [id], onUpdate: NoAction)
  data_sources       data_sources?     @relation(fields: [source_id], references: [id], onUpdate: NoAction)

  @@index([college_id, academic_year(sort: Desc)], map: "idx_college_fees_lookup")
}

model college_institute_codes {
  id                        Int                     @id @default(autoincrement())
  college_id                Int
  counselling_authority_id  Int                     @db.SmallInt
  institute_code            String
  institute_name_as_printed String?
  created_at                DateTime                @default(now()) @db.Timestamptz(6)
  colleges                  colleges                @relation(fields: [college_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  counselling_authorities   counselling_authorities @relation(fields: [counselling_authority_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([counselling_authority_id, institute_code])
  @@index([college_id], map: "idx_college_institute_codes_college")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
/// This model or at least one of its fields has comments in the database, and requires an additional setup for migrations: Read more: https://pris.ly/d/database-comments
model colleges {
  id                         Int                          @id @default(autoincrement())
  slug                       String                       @unique
  name                       String
  short_name                 String?
  aicte_code                 String?
  aishe_code                 String?
  college_type               college_type
  ownership                  ownership_type
  affiliated_university      String?
  state_id                   Int                          @db.SmallInt
  city_id                    Int?
  address                    String?
  pincode                    String?
  latitude                   Decimal?                     @db.Decimal(9, 6)
  longitude                  Decimal?                     @db.Decimal(9, 6)
  website                    String?
  email                      String?
  phone                      String?
  established_year           Int?                         @db.SmallInt
  is_autonomous              Boolean                      @default(false)
  has_hostel                 Boolean?
  about                      String?
  logo_url                   String?
  banner_url                 String?
  nirf_rank_latest           Int?                         @db.SmallInt
  nirf_year_latest           Int?                         @db.SmallInt
  is_active                  Boolean                      @default(true)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  college_accreditations     college_accreditations[]
  college_branches           college_branches[]
  college_campuses           college_campuses[]
  college_fees               college_fees[]
  college_institute_codes    college_institute_codes[]
  cities                     cities?                      @relation(fields: [city_id], references: [id], onUpdate: NoAction)
  states                     states                       @relation(fields: [state_id], references: [id], onUpdate: NoAction)
  hostel_data                hostel_data[]
  notification_subscriptions notification_subscriptions[]
  placement_data             placement_data[]
  prediction_results         prediction_results[]

  @@index([name(ops: raw("gin_trgm_ops"))], map: "idx_colleges_name_trgm", type: Gin)
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model counselling_authorities {
  id                         Int                          @id @default(autoincrement()) @db.SmallInt
  code                       String                       @unique
  name                       String
  scope                      counselling_scope
  state_id                   Int?                         @db.SmallInt
  official_website           String?
  logo_url                   String?
  description                String?
  is_active                  Boolean                      @default(true)
  created_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  updated_at                 DateTime                     @default(now()) @db.Timestamptz(6)
  branch_aliases             branch_aliases[]
  college_institute_codes    college_institute_codes[]
  states                     states?                      @relation(fields: [state_id], references: [id], onUpdate: NoAction)
  counselling_processes      counselling_processes[]
  data_sources               data_sources[]
  prediction_results         prediction_results[]
  prediction_weight_profiles prediction_weight_profiles[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model counselling_dimension_map {
  id                     Int                   @id @default(autoincrement())
  counselling_process_id Int
  dimension              String
  ref_id                 Int                   @db.SmallInt
  source_label           String
  display_label          String?
  display_order          Int                   @default(100) @db.SmallInt
  is_active              Boolean               @default(true)
  created_at             DateTime              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime              @default(now()) @db.Timestamptz(6)
  counselling_processes  counselling_processes @relation(fields: [counselling_process_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([counselling_process_id, dimension, source_label])
  @@index([counselling_process_id, dimension, ref_id], map: "idx_dimension_map_lookup")
}

model counselling_exams {
  id                       Int                   @id @default(autoincrement())
  counselling_process_id   Int
  exam_id                  Int                   @db.SmallInt
  applies_to_college_types college_type[]
  is_primary               Boolean               @default(true)
  notes                    String?
  created_at               DateTime              @default(now()) @db.Timestamptz(6)
  counselling_processes    counselling_processes @relation(fields: [counselling_process_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  exams                    exams                 @relation(fields: [exam_id], references: [id], onUpdate: NoAction)

  @@unique([counselling_process_id, exam_id])
  @@index([exam_id], map: "idx_counselling_exams_exam")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model counselling_processes {
  id                        Int                         @id @default(autoincrement())
  counselling_authority_id  Int                         @db.SmallInt
  academic_year             Int                         @db.SmallInt
  code                      String                      @unique
  name                      String
  rank_basis                String                      @default("category_rank")
  total_rounds              Int?                        @db.SmallInt
  registration_url          String?
  cutoff_url                String?
  seat_matrix_url           String?
  is_published              Boolean                     @default(false)
  created_at                DateTime                    @default(now()) @db.Timestamptz(6)
  updated_at                DateTime                    @default(now()) @db.Timestamptz(6)
  counselling_dimension_map counselling_dimension_map[]
  counselling_exams         counselling_exams[]
  counselling_authorities   counselling_authorities     @relation(fields: [counselling_authority_id], references: [id], onUpdate: NoAction)
  counselling_rounds        counselling_rounds[]
  cutoff_data               cutoff_data[]
  data_import_jobs          data_import_jobs[]
  data_sources              data_sources[]
  seat_matrix               seat_matrix[]

  @@unique([counselling_authority_id, academic_year])
  @@index([academic_year(sort: Desc)], map: "idx_counselling_processes_year")
}

model counselling_rounds {
  id                     Int                   @id @default(autoincrement())
  counselling_process_id Int
  round_no               Int                   @db.SmallInt
  name                   String
  kind                   round_kind            @default(regular)
  allotment_date         DateTime?             @db.Date
  reporting_start        DateTime?             @db.Date
  reporting_end          DateTime?             @db.Date
  is_final_regular_round Boolean               @default(false)
  cutoff_published       Boolean               @default(false)
  created_at             DateTime              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime              @default(now()) @db.Timestamptz(6)
  counselling_processes  counselling_processes @relation(fields: [counselling_process_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  cutoff_data            cutoff_data[]
  data_import_jobs       data_import_jobs[]
  seat_matrix            seat_matrix[]

  @@unique([counselling_process_id, round_no, kind])
}

/// This table is a partition table and requires additional setup for migrations. Visit https://pris.ly/d/partition-tables for more info.
/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model cutoff_data {
  id                     BigInt                @default(autoincrement())
  academic_year          Int                   @db.SmallInt
  counselling_process_id Int
  counselling_round_id   Int
  round_no               Int                   @db.SmallInt
  exam_id                Int                   @db.SmallInt
  college_branch_id      BigInt
  college_id             Int
  branch_id              Int                   @db.SmallInt
  seat_type_id           Int                   @db.SmallInt
  category_id            Int                   @db.SmallInt
  quota_id               Int                   @db.SmallInt
  gender_id              Int                   @db.SmallInt
  opening_rank           BigInt?
  closing_rank           BigInt?
  opening_percentile     Decimal?              @db.Decimal(11, 8)
  closing_percentile     Decimal?              @db.Decimal(11, 8)
  opening_score          Decimal?              @db.Decimal(10, 4)
  closing_score          Decimal?              @db.Decimal(10, 4)
  rank_basis             String                @default("category_rank")
  seats_offered          Int?                  @db.SmallInt
  is_preparatory         Boolean               @default(false)
  source_id              Int?
  import_job_id          BigInt?
  is_verified            Boolean               @default(false)
  imported_at            DateTime              @default(now()) @db.Timestamptz(6)
  updated_at             DateTime              @default(now()) @db.Timestamptz(6)
  categories             categories            @relation(fields: [category_id], references: [id], onUpdate: NoAction)
  counselling_processes  counselling_processes @relation(fields: [counselling_process_id], references: [id], onUpdate: NoAction)
  counselling_rounds     counselling_rounds    @relation(fields: [counselling_round_id], references: [id], onUpdate: NoAction)
  exams                  exams                 @relation(fields: [exam_id], references: [id], onUpdate: NoAction)
  genders                genders               @relation(fields: [gender_id], references: [id], onUpdate: NoAction)
  data_import_jobs       data_import_jobs?     @relation(fields: [import_job_id], references: [id], onUpdate: NoAction)
  quotas                 quotas                @relation(fields: [quota_id], references: [id], onUpdate: NoAction)
  seat_types             seat_types            @relation(fields: [seat_type_id], references: [id], onUpdate: NoAction)
  data_sources           data_sources?         @relation(fields: [source_id], references: [id], onUpdate: NoAction)
  college_branches       college_branches      @relation(fields: [college_branch_id, college_id, branch_id], references: [id, college_id, branch_id], onDelete: Cascade, onUpdate: NoAction, map: "fk_cutoff_program")

  @@id([academic_year, id])
  @@unique([academic_year, counselling_process_id, round_no, college_branch_id, seat_type_id, quota_id, gender_id], map: "uq_cutoff_natural")
  @@index([college_id, branch_id, seat_type_id, quota_id, gender_id, academic_year(sort: Desc), round_no(sort: Desc)], map: "idx_cutoff_by_college")
  @@index([college_branch_id, seat_type_id, quota_id, gender_id, academic_year(sort: Desc), round_no(sort: Desc)], map: "idx_cutoff_by_program")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model data_change_logs {
  id               BigInt            @id @default(autoincrement())
  table_name       String
  row_id           BigInt
  action           change_action
  changed_fields   String[]
  old_values       Json?
  new_values       Json?
  import_job_id    BigInt?
  actor_user_id    BigInt?
  actor_kind       String            @default("system")
  created_at       DateTime          @default(now()) @db.Timestamptz(6)
  data_import_jobs data_import_jobs? @relation(fields: [import_job_id], references: [id], onUpdate: NoAction)
  users            users?            @relation(fields: [actor_user_id], references: [id], onUpdate: NoAction, map: "fk_change_logs_actor")

  @@index([table_name, row_id, created_at(sort: Desc)], map: "idx_change_logs_row")
  @@index([created_at(sort: Desc)], map: "idx_change_logs_time")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model data_import_jobs {
  id                     BigInt                 @id @default(autoincrement())
  source_id              Int
  counselling_process_id Int?
  counselling_round_id   Int?
  academic_year          Int?                   @db.SmallInt
  status                 import_status          @default(queued)
  trigger_kind           String                 @default("scheduler")
  artifact_url           String?
  artifact_path          String?
  content_hash           String?
  rows_parsed            Int                    @default(0)
  rows_valid             Int                    @default(0)
  rows_invalid           Int                    @default(0)
  rows_duplicate         Int                    @default(0)
  rows_inserted          Int                    @default(0)
  rows_updated           Int                    @default(0)
  error_summary          String?
  validation_report      Json?
  started_at             DateTime?              @db.Timestamptz(6)
  finished_at            DateTime?              @db.Timestamptz(6)
  reviewed_by            BigInt?
  reviewed_at            DateTime?              @db.Timestamptz(6)
  review_note            String?
  published_at           DateTime?              @db.Timestamptz(6)
  created_at             DateTime               @default(now()) @db.Timestamptz(6)
  updated_at             DateTime               @default(now()) @db.Timestamptz(6)
  cutoff_data            cutoff_data[]
  data_change_logs       data_change_logs[]
  counselling_processes  counselling_processes? @relation(fields: [counselling_process_id], references: [id], onUpdate: NoAction)
  counselling_rounds     counselling_rounds?    @relation(fields: [counselling_round_id], references: [id], onUpdate: NoAction)
  data_sources           data_sources           @relation(fields: [source_id], references: [id], onUpdate: NoAction)
  users                  users?                 @relation(fields: [reviewed_by], references: [id], onUpdate: NoAction, map: "fk_import_jobs_reviewer")
  data_import_staging    data_import_staging[]
  seat_matrix            seat_matrix[]

  @@index([source_id, created_at(sort: Desc)], map: "idx_import_jobs_source")
  @@index([status, created_at(sort: Desc)], map: "idx_import_jobs_status")
}

model data_import_staging {
  id                BigInt             @id @default(autoincrement())
  import_job_id     BigInt
  row_no            Int
  target_table      String
  raw               Json
  normalized        Json?
  status            staging_row_status @default(pending)
  validation_errors Json?
  target_row_id     BigInt?
  created_at        DateTime           @default(now()) @db.Timestamptz(6)
  data_import_jobs  data_import_jobs   @relation(fields: [import_job_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([import_job_id, row_no])
  @@index([import_job_id, status], map: "idx_staging_job_status")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model data_sources {
  id                       Int                       @id @default(autoincrement())
  code                     String                    @unique
  name                     String
  url                      String
  kind                     source_kind
  tier                     source_tier
  adapter_key              String
  data_type                String
  exam_id                  Int?                      @db.SmallInt
  counselling_authority_id Int?                      @db.SmallInt
  counselling_process_id   Int?
  poll_cron                String                    @default("0 */6 * * *")
  last_content_hash        String?
  last_checked_at          DateTime?                 @db.Timestamptz(6)
  last_success_at          DateTime?                 @db.Timestamptz(6)
  last_error               String?
  consecutive_failures     Int                       @default(0) @db.SmallInt
  auto_publish_allowed     Boolean                   @default(false)
  is_active                Boolean                   @default(true)
  notes                    String?
  created_at               DateTime                  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime                  @default(now()) @db.Timestamptz(6)
  college_accreditations   college_accreditations[]
  college_fees             college_fees[]
  cutoff_data              cutoff_data[]
  data_import_jobs         data_import_jobs[]
  counselling_authorities  counselling_authorities?  @relation(fields: [counselling_authority_id], references: [id], onUpdate: NoAction)
  counselling_processes    counselling_processes?    @relation(fields: [counselling_process_id], references: [id], onUpdate: NoAction)
  exams                    exams?                    @relation(fields: [exam_id], references: [id], onUpdate: NoAction)
  exam_rank_data           exam_rank_data[]
